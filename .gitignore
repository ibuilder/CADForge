/target
**/*.rs.bk
Cargo.lock.bak
*.pdb

# Demo / scratch output. site/assets is documentation and is tracked.
/out
*.obj
!site/assets/*.png

# Editors
.vscode/
.idea/
*.swp
.DS_Store

